<?xml version="1.0" encoding="UTF-8" ?>
<!-- This file contains a list of plugins to be instantiated by beaTunes -->
<plugins>
    <name>Similar Songs Table</name>
    <id>similarsongstable</id>
    <version>${project.version}</version>
    <description>beaTunes plugin that shows the content of the hidden similar songs playlist. A new menu item is added to the "Controls" menu.</description>
    <license>
        <name>GNU Lesser General Public License 2.1</name>
        <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.txt</url>
    </license>
    <change-notes>1.0.2:
- Update for beaTunes 6.

1.0.1
- Improved repaint behavior

1.0.0
- First release.
    </change-notes>
    <vendor>
        <name>Jalulo UG (haftungsbeschränkt)</name>
        <url>https://www.jalulo.eu/</url>
        <email>support@jalulo.eu</email>
        <logo>https://www.jalulo.eu/images/jalulo_icon_256.png</logo>
    </vendor>
    <beatunes-version>
        <min>6.0.0</min>
        <max>6.9.9</max>
    </beatunes-version>

    <!-- Analysis Tasks -->
    <plugin class="com.beatunes.similarsongstable.ShowSimilarSongsAction"/>
</plugins>
