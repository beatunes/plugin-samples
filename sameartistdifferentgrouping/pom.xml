<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.beatunes</groupId>
    <artifactId>sameartistdifferentgrouping</artifactId>
    <version>1.0.3</version>
    <packaging>jar</packaging>
    <name>beaTunes inspection that finds songs with the same artist, but a different grouping</name>
    <url>https://www.beatunes.com/</url>
    <developers>
        <developer>
            <name>Hendrik Schreiber</name>
            <email>hs@jalulo.eu</email>
            <url>https://www.jalulo.eu/</url>
            <organization>Jalulo UG (haftungsbeschränkt)</organization>
            <organizationUrl>https://www.jalulo.eu/</organizationUrl>
        </developer>
    </developers>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
            <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.txt</url>
        </license>
    </licenses>
    <repositories>
        <repository>
            <id>beatunes</id>
            <name>beaTunes Repository</name>
            <url>https://www.beatunes.com/repo/maven2</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>com.tagtraum</groupId>
            <artifactId>beatunes</artifactId>
            <version>${beatunes.version}</version>
            <exclusions>
                <!-- exclude some dependencies that are not in public repositories -->
                <exclusion>
                    <groupId>com.sun.media.jai</groupId>
                    <artifactId>jai-codec</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.media.jai</groupId>
                    <artifactId>jai-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.explodingpixels</groupId>
                    <artifactId>mac_widgets</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>net.jthink</groupId>
                    <artifactId>jaudiotagger</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.transaction</groupId>
                    <artifactId>jta</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <!-- make sure the version in plugin.xml is updated automatically -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>META-INF/plugin.xml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/*.xml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <scm>
        <connection>scm:git:https://github.com/beatunes/plugin-samples.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/beatunes/plugin-samples.git</developerConnection>
        <url>https://github.com/beatunes/plugin-samples/tree/master/sameartistdifferentgrouping</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/beatunes/plugin-samples/issues</url>
    </issueManagement>
    <properties>
        <!-- The beaTunes version to compile against. -->
        <beatunes.version>6.0.0</beatunes.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
